# Project Churro graphics stack selection: androidboot.churro.gfx=native (default) | mesa | soft
# native: Googlebook's own Intel Gen12+ stack (ANGLE on ANV)
# mesa:   Mesa GL (iris/crocus/virgl) + Mesa Vulkan if androidboot.churro.vulkan is set
# soft:   Mesa softpipe, works on any display (slow)
import /system_ext/etc/init/churro/gfx-${ro.boot.churro.gfx:-native}.rc
